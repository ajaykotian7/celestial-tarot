# Copy this file to .env and fill in your values.

# Required: OpenAI API key used for GPT-4o readings.
# (MY_OPEN_AI_KEY is also accepted as a fallback name.)
OPENAI_API_KEY=sk-your-key-here

# Optional: PIN required to unlock the app.
# Leave empty to disable the gatekeeper screen (anyone can use the app).
APP_ACCESS_PIN=

# Optional: number of proxies that append to X-Forwarded-For (default 1, for Render).
# Has no effect locally, where requests arrive without that header.
# TRUSTED_PROXY_HOPS=1
